 	if (commonring->cr_write_wptr)
 		commonring->cr_write_wptr(commonring->cr_ctx);
 	commonring->f_ptr = 0;
+	commonring->stamp_ptr = 0;
+	commonring->phase = 0;
+	commonring->seqnum = BRCMF_H2D_EPOCH_INIT;
