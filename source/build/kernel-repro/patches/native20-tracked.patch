+/*
+ * Every host-to-dongle work item carries a per-ring sequence number in
+ * the common header's 4th byte ("epoch") and a phase bit in the flags
+ * byte, the way Broadcom's DHD stamps them: epoch = seqnum % 253 with
+ * seqnum starting at 254, phase (bit 7) flipped whenever an allocation
+ * lands on the ring base. Firmware that verifies them (BCM4361 B2)
+ * rejects unstamped items with ring status BADOPTION.
+ */
+#define BRCMF_H2D_EPOCH_MODULO	253
+#define BRCMF_H2D_EPOCH_INIT	(BRCMF_H2D_EPOCH_MODULO + 1)
+#define BRCMF_H2D_PHASE_BIT	0x80
+
+static void brcmf_commonring_stamp(struct brcmf_commonring *commonring)
+{
+	u8 *item;
+
+	while (commonring->stamp_ptr != commonring->w_ptr) {
+		if (commonring->stamp_ptr == 0)
+			commonring->phase ^= BRCMF_H2D_PHASE_BIT;
+		item = commonring->buf_addr +
+		       commonring->stamp_ptr * commonring->item_len;
+		item[2] = (item[2] & ~BRCMF_H2D_PHASE_BIT) | commonring->phase;
+		item[3] = commonring->seqnum % BRCMF_H2D_EPOCH_MODULO;
+		commonring->seqnum++;
+		commonring->stamp_ptr++;
+		if (commonring->stamp_ptr == commonring->depth)
+			commonring->stamp_ptr = 0;
+	}
+}
