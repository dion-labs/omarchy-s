 static inline void rmw(void __iomem *reg, u32 clear, u32 set)
 {
 	writel((readl(reg) & ~clear) | set, reg);
+}
+
+/* The PHY core serializes init, power and mode callbacks with its mutex.
+ * This configures USB signalling only: it never sources connector VBUS. */
+static void s9p_usbphy_apply_mode(struct s9p_usbphy *p)
+{
+        void __iomem *r = p->regs;
+
+        if (p->mode == PHY_MODE_USB_HOST) {
+                /* Vendor phy_exynos_usb_v3p1_config_host_mode(). */
+                rmw(r + USBCON_UTMI, UTMI_FORCE_BVALID | UTMI_FORCE_VBUSVALID,
+                    UTMI_DP_PULLDOWN | UTMI_DM_PULLDOWN);
+                rmw(r + USBCON_HSP, HSP_VBUSVLDEXTSEL | HSP_VBUSVLDEXT, 0);
+        } else {
+                /* Restore the accepted device-mode signalling. */
+                rmw(r + USBCON_UTMI, UTMI_DP_PULLDOWN | UTMI_DM_PULLDOWN,
+                    UTMI_FORCE_BVALID | UTMI_FORCE_VBUSVALID);
+                rmw(r + USBCON_HSP, 0, HSP_VBUSVLDEXTSEL | HSP_VBUSVLDEXT);
+        }
+        if (s9p_phy_tune)
+                rmw(r + USBCON_HSP_TUNE, S9P_HSP_TUNE_MASK,
+                    p->mode == PHY_MODE_USB_HOST ? S9P_HSP_TUNE_HOST_VAL :
+                                                  S9P_HSP_TUNE_VAL);
+}
+
+static int s9p_usbphy_set_mode(struct phy *phy, enum phy_mode mode, int submode)
+{
+        struct s9p_usbphy *p = phy_get_drvdata(phy);
+
+        if (submode || (mode != PHY_MODE_USB_HOST && mode != PHY_MODE_USB_DEVICE))
+                return -EINVAL;
+        p->mode = mode;
+        /* Cache requests while clocks are off or the PHY is isolated. */
+        if (p->initialized && p->powered)
+                s9p_usbphy_apply_mode(p);
+        return 0;
 }
 
