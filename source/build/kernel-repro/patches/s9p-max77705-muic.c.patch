+/* This diagnostic driver is the sole reader of UIC_INT at address0x25.
+ * Reading it acknowledges all UIC flags; retain other bits in the log.
+ * Do not share this transport with a future interrupt-driven Type-C driver. */
+static int muic_completion(struct s9p_muic *m)
+{
+        int value = muic_read(m, REG_UIC_INT);
+
+        if (value >= 0 && (value & ~BIT(7)))
+                dev_info(&m->client->dev, "UIC events during mailbox query: %02x\n",
+                         (unsigned int)(value & ~BIT(7)));
+        return value;
+}
+
+/* Caller holds opcode_lock. After an ambiguous failure, refuse new commands
+ * until a new boot/bind so a late response cannot satisfy another request. */
+static int muic_transaction(struct s9p_muic *m, u8 opcode,
+                            const u8 *data, int len, u8 *reply, int reply_len)
+{
+        int ret, attempt;
+
+        if (m->mailbox_fault)
+                return -EIO;
+        ret = muic_completion(m); /* discard stale completion before request */
+        if (ret < 0)
+                goto fault;
+        ret = muic_opcode_write(m, opcode, data, len);
+        if (ret)
+                goto fault;
+        for (attempt = 0; attempt < 50; attempt++) {
+                msleep(10);
+                ret = muic_completion(m);
+                if (ret < 0)
+                        goto fault;
+                if (!(ret & BIT(7)))
+                        continue;
+                ret = muic_opcode_result(m, reply, reply_len);
+                if (ret < 0)
+                        goto fault;
+                if (ret != reply_len || reply[0] != opcode) {
+                        ret = -EPROTO;
+                        goto fault;
+                }
+                return 0;
+        }
+        ret = -ETIMEDOUT;
+fault:
+        m->mailbox_fault = true;
+        return ret;
+}
