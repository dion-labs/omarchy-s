+/* Status registers only: do not read clear-on-read interrupt registers. */
+static ssize_t connector_status_show(struct device *dev,
+                                     struct device_attribute *attr, char *buf)
+{
+        struct s9p_muic *m = i2c_get_clientdata(to_i2c_client(dev));
+        int bc, cc0, cc1, pd0, pd1;
+
+        bc = muic_read(m, REG_BC_STATUS);
+        cc0 = muic_read(m, REG_CC_STATUS0);
+        cc1 = muic_read(m, REG_CC_STATUS1);
+        pd0 = muic_read(m, REG_PD_STATUS0);
+        pd1 = muic_read(m, REG_PD_STATUS1);
+        if (bc < 0 || cc0 < 0 || cc1 < 0 || pd0 < 0 || pd1 < 0)
+                return -EIO;
+        return sysfs_emit(buf, "bc=%02x cc0=%02x cc1=%02x pd0=%02x pd1=%02x\n",
+                          bc, cc0, cc1, pd0, pd1);
+}
