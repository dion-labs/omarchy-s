+
+/* Only vendor CCCTRL read opcodes; no CC configuration/power writes. */
+static int muic_read_control(struct s9p_muic *m, u8 opcode, u8 *value)
+{
+        u8 reply[2];
+        int ret;
+
+        if (opcode != 0x0b && opcode != 0x0d && opcode != 0x0f)
+                return -EINVAL;
+        ret = muic_transaction(m, opcode, NULL, 0, reply, sizeof(reply));
+        if (!ret)
+                *value = reply[1];
+        return ret;
+}
+
+static ssize_t connector_controls_show(struct device *dev,
+                                       struct device_attribute *attr, char *buf)
+{
+        struct s9p_muic *m = i2c_get_clientdata(to_i2c_client(dev));
+        u8 cc[3];
+        int i, ret = 0;
+
+        mutex_lock(&m->opcode_lock);
+        for (i = 0; i < ARRAY_SIZE(cc); i++) {
+                ret = muic_read_control(m, 0x0b + 2 * i, &cc[i]);
+                if (ret)
+                        break;
+        }
+        mutex_unlock(&m->opcode_lock);
+        if (ret)
+                return ret;
+        return sysfs_emit(buf, "ccctrl1=%02x ccctrl2=%02x ccctrl3=%02x\n",
+                          cc[0], cc[1], cc[2]);
+}
+/* Explicit administrator diagnostic; do not poll this alongside status. */
